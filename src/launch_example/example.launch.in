<segar>
  <environment>
    <RTI_ENV_WORKROOT>@CMAKE_INSTALL_PREFIX@</RTI_ENV_WORKROOT>
    <SEGAR_PATH>@CMAKE_INSTALL_PREFIX@</SEGAR_PATH>
    <SEGAR_GLOBAL_PATH>@CMAKE_INSTALL_PREFIX@</SEGAR_GLOBAL_PATH>
    <RTI_DAG_PATH>@CMAKE_INSTALL_PREFIX@/integration_test</RTI_DAG_PATH>
    <RTI_LIB_PATH>@CMAKE_INSTALL_PREFIX@/integration_test</RTI_LIB_PATH>
    <RTI_PARAM_PATH>@CMAKE_INSTALL_PREFIX@/integration_test</RTI_PARAM_PATH>
    <RTI_CONF_PATH>@CMAKE_INSTALL_PREFIX@/integration_test</RTI_CONF_PATH>
  </environment>
  <module>
    <name>itest_tracing_node</name>
    <dag_conf>dag/tracing_node.dag</dag_conf>
    <process_name>itest_tracing_node</process_name>
  </module>
  <module>
    <name>itest_node_a</name>
    <dag_conf>dag/node_a.dag</dag_conf>
    <process_name>itest_node_a</process_name>
  </module>
  <module>
    <name>itest_param_timer</name>
    <dag_conf>dag/param_timer.dag</dag_conf>
    <process_name>itest_param_timer</process_name>
  </module>
  <module>
    <name>itest_sensor_1</name>
    <type>binary</type>
    <process_name>@CMAKE_INSTALL_PREFIX@/integration_test/bin/sensor_node @CMAKE_INSTALL_PREFIX@/integration_test/params/sensor_config.json 1</process_name>
  </module>
  <module>
    <name>itest_sensor_2</name>
    <type>binary</type>
    <process_name>@CMAKE_INSTALL_PREFIX@/integration_test/bin/sensor_node @CMAKE_INSTALL_PREFIX@/integration_test/params/sensor_config.json 2</process_name>
  </module>
  <module>
    <name>itest_sensor_3</name>
    <type>binary</type>
    <process_name>@CMAKE_INSTALL_PREFIX@/integration_test/bin/sensor_node @CMAKE_INSTALL_PREFIX@/integration_test/params/sensor_config.json 3</process_name>
  </module>
</segar>
